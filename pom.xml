<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ================================================================== -->
    <!-- DP MyWebApp Project                                                -->
    <!-- ================================================================== -->

    <groupId>com.dp</groupId>
    <artifactId>dp-mywebapp</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>DP MyWebApp</name>
    <description>
        Java web application for the DP production-grade DevSecOps CI/CD platform.
    </description>

    <!-- ================================================================== -->
    <!-- Build Properties                                                   -->
    <!-- ================================================================== -->

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Java -->
        <maven.compiler.release>17</maven.compiler.release>

        <!-- SonarQube Cloud -->
        <sonar.organization>davidakud1-eng</sonar.organization>
        <sonar.projectKey>davidakud1-eng_dp-mywebapp</sonar.projectKey>

        <!-- JFrog Artifactory -->
        <!-- Supplied by the Jenkins pipeline at build time -->
        <artifactory.url>${env.ARTIFACTORY_URL}</artifactory.url>

        <!-- Dependency Versions -->
        <junit.version>5.11.4</junit.version>

        <!-- Maven Plugin Versions -->
        <maven.compiler.version>3.13.0</maven.compiler.version>
        <maven.jar.version>3.4.2</maven.jar.version>
        <surefire.version>3.5.2</surefire.version>
        <jacoco.version>0.8.12</jacoco.version>
        <sonar.maven.version>5.2.0.4988</sonar.maven.version>
    </properties>

    <!-- ================================================================== -->
    <!-- Dependencies                                                       -->
    <!-- ================================================================== -->

    <dependencies>

        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ================================================================== -->
    <!-- Artifact Distribution - JFrog Artifactory                         -->
    <!-- ================================================================== -->

    <distributionManagement>

        <!-- Stable release artifacts -->
        <repository>
            <id>dp-artifactory-release</id>
            <name>DP Artifactory Releases</name>
            <url>${artifactory.url}/libs-release-local</url>
        </repository>

        <!-- Development snapshot artifacts -->
        <snapshotRepository>
            <id>dp-artifactory-snapshot</id>
            <name>DP Artifactory Snapshots</name>
            <url>${artifactory.url}/libs-snapshot-local</url>
        </snapshotRepository>

    </distributionManagement>

    <!-- ================================================================== -->
    <!-- Build Configuration                                                -->
    <!-- ================================================================== -->

    <build>
        <plugins>

            <!-- ========================================================== -->
            <!-- Java Compilation                                          -->
            <!-- ========================================================== -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <!-- ========================================================== -->
            <!-- Executable JAR Packaging                                  -->
            <!-- ========================================================== -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${maven.jar.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.dp.mywebapp.Application</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- ========================================================== -->
            <!-- Unit Testing - JUnit 5                                    -->
            <!-- ========================================================== -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
            </plugin>

            <!-- ========================================================== -->
            <!-- Code Coverage - JaCoCo                                    -->
            <!-- ========================================================== -->

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>

                <executions>

                    <!-- Attach JaCoCo agent before tests execute -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>

                    <!-- Generate coverage report during verify -->
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>

                </executions>
            </plugin>

            <!-- ========================================================== -->
            <!-- Static Code Analysis - SonarQube Cloud                    -->
            <!-- ========================================================== -->

            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar.maven.version}</version>
            </plugin>

        </plugins>
    </build>

</project>