<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ================================================================== -->
    <!-- DP MyWebApp Project                                                -->
    <!-- ================================================================== -->

    <groupId>com.dp</groupId>
    <artifactId>dp-mywebapp</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>DP MyWebApp</name>
    <description>
        Java web application for the DP production-grade DevSecOps CI/CD platform.
    </description>

    <!-- ================================================================== -->
    <!-- Build Properties                                                   -->
    <!-- ================================================================== -->

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Java -->
        <maven.compiler.release>17</maven.compiler.release>

        <!-- SonarQube Cloud -->
        <sonar.organization>davidakud1-eng</sonar.organization>
        <sonar.projectKey>davidakud1-eng_dp-mywebapp</sonar.projectKey>

        <!-- Dependency Versions -->
        <junit.version>5.11.4</junit.version>

        <!-- Maven Plugin Versions -->
        <maven.compiler.version>3.13.0</maven.compiler.version>
        <surefire.version>3.5.2</surefire.version>
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <!-- ================================================================== -->
    <!-- Dependencies                                                       -->
    <!-- ================================================================== -->

    <dependencies>

        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ================================================================== -->
    <!-- Build Configuration                                                -->
    <!-- ================================================================== -->

    <build>
        <plugins>

            <!-- ========================================================== -->
            <!-- Java Compilation                                          -->
            <!-- ========================================================== -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <!-- ========================================================== -->
            <!-- Unit Testing - JUnit 5                                    -->
            <!-- ========================================================== -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
            </plugin>

            <!-- ========================================================== -->
            <!-- Code Coverage - JaCoCo                                    -->
            <!-- ========================================================== -->

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>

                <executions>

                    <!-- Attach JaCoCo agent before tests execute -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>

                    <!-- Generate coverage report during verify -->
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>

                </executions>
            </plugin>

        </plugins>
    </build>

</project>